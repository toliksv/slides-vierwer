{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Extensions": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Extensions": "Warning",
        "Confluent": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/slides-correction-worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "ConsumerGroupId": "slides-correction-worker",
    "AnalysisTopic": "slides-analysis-requests"
  },
  "CaptureOne": {
    "ScriptsFolder": "E:\\ИИ слайды\\Scripts"
  }
}
