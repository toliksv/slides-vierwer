@{
    ViewData["Title"] = "Анализ плёночных сканов";
}

<h2>Анализ плёночных сканов</h2>

<p>Укажите путь к 48-битному TIFF-скану фотографической плёнки для анализа деградации и генерации параметров коррекции для Capture One.</p>

@using System.Linq

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form id="analysisForm" method="post" enctype="application/x-www-form-urlencoded">
    <div class="mb-3">
        <label for="slideFilePath" class="form-label">Путь к TIFF файлу</label>
        <input type="text" id="slideFilePath" name="SlideFilePath" class="form-control" placeholder="https://example.com/image.tiff или C:\path\to\image.tiff" required />
        <small class="text-muted">Поддерживаются только 48-битные TIFF файлы</small>
    </div>
    
    <button type="submit" class="btn btn-primary" id="submitBtn">Анализировать</button>
</form>

<div id="statusMessage" class="mt-3" style="display:none;">
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        <span id="statusText">Отправка на анализ...</span>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["Error"]
    </div>
}

<script>
    const hostApiBaseUrl = '@(ViewBag.HostApiBaseUrl ?? "http://localhost:5041/")';

    document.getElementById('analysisForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const filePathInput = document.getElementById('slideFilePath');
        if (!filePathInput.value.trim()) {
            alert('Укажите путь к TIFF файлу');
            return;
        }

        const formData = new FormData();
        formData.append('SlideFilePath', filePathInput.value.trim());

        const statusMessage = document.getElementById('statusMessage');
        const statusText = document.getElementById('statusText');
        const submitBtn = document.getElementById('submitBtn');

        statusMessage.style.display = 'block';
        submitBtn.disabled = true;
        statusText.textContent = 'Отправка на анализ...';

        try {
            const response = await fetch(hostApiBaseUrl + 'api/FilmAnalysis/analyze', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                statusText.textContent = 'Запрос на анализ успешно отправлен: ' + data.filePath;
            } else {
                const errorText = await response.text();
                statusText.textContent = 'Ошибка: ' + (errorText || response.statusText);
            }
        } catch (err) {
            statusText.textContent = 'Ошибка сети: ' + err.message;
        } finally {
            submitBtn.disabled = false;
        }
    });
</script>
