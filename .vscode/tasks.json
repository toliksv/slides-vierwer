{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-sln",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SlidesViewer.sln"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-Host",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SlidesViewer.Host/SlidesViewer.Host.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-Web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SlidesViewer.Web/SlidesViewer.Web.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
